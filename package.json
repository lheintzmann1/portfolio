{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i ./tailwind.css -o ./wwwroot/assets/tailwind.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./tailwind.css -o ./wwwroot/assets/tailwind.css --minify",
    "dev:app": "dotnet watch",
    "dev": "npm run dev:css & npm run dev:app"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17"
  }
}
