@* About section with personal introduction and statistics.
   Two-column layout with avatar card and biography. *@

<section id="about"
         class="min-h-screen w-full py-20 px-8 sm:px-12 md:px-16 lg:px-20 xl:px-24 2xl:px-32">
    <div class="max-w-7xl mx-auto">
        <SectionTitle Title="About Me" />

        <div class="grid md:grid-cols-2 gap-12 items-center">
            @* Avatar card *@
            <div class="relative">
                <div class="aspect-square max-w-md mx-auto rounded-[32px] @Styles.GlassContainerBg backdrop-blur-xl border border-white/[0.08] overflow-hidden shadow-2xl shadow-black/40 hover:shadow-blue-500/10 transition-all duration-700 ease-in-out hover:border-white/[0.12]">
                    <img src="assets/me.png" alt="Profile photo" class="w-full h-full object-cover" />
                </div>
            </div>

            <div class="space-y-6">
                @foreach (var paragraph in _profile.Bio)
                {
                    <p class="text-gray-300 text-lg leading-relaxed">@paragraph</p>
                }

                @* Stats grid *@
                <div class="grid grid-cols-3 gap-8 mt-12">
                    @foreach (var stat in _profile.Stats)
                    {
                        <div class="text-center">
                            <div class="text-4xl font-light text-white mb-2">@stat.Value</div>
                            <div class="text-gray-500 text-xs mt-1 tracking-wider uppercase">@stat.Label</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly ProfileData _profile = SiteData.Profile;
}
