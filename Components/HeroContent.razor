@* Hero text: role badge, headline and introduction paragraph. *@

<div class="w-full px-8 sm:px-12 md:px-16 lg:px-20 xl:px-24 2xl:px-32">
    <div class="flex flex-col gap-5 text-start">
        @* Role badge with sparkle icon *@
        <div class="Welcome-box py-2 px-[7px] border border-[#7042f88b]">
            <SparklesIcon Class="text-[#b49bff] mr-2.5 ml-1.5 h-5 w-5" />
            <h1 class="Welcome-text text-[13px]" style="@Styles.FontInter font-weight: 500;">
                @_profile.Role
            </h1>
        </div>

        @* Main headline *@
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-white mt-4 max-w-[600px]"
            style="@Styles.FontInter font-weight: 400; font-size: 3.75rem;">
            @_profile.Headline
        </h1>

        @* Introduction paragraph *@
        <p class="text-xl md:text-2xl text-gray-400 mt-4 max-w-[600px]"
           style="@Styles.FontInter font-weight: 400; font-size: 1.125rem; line-height: 1.75rem;">
            @_profile.Intro
        </p>
    </div>
</div>

@code {
    private readonly ProfileData _profile = SiteData.Profile;
}
