@* Contact section with information, social links, and a functional form.
   Uses FormSubmit for serverless form handling.

   Layout:
   - Left column: Contact details and social media links
   - Right column: Contact form (powered by FormSubmit) *@

<section id="contact"
         class="min-h-screen w-full py-20 px-8 sm:px-12 md:px-16 lg:px-20 xl:px-24 2xl:px-32 flex items-center">
    <div class="max-w-6xl mx-auto w-full">
        @* Section header with title and intro *@
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-4" style="@Styles.FontInter">
                Get In Touch
            </h2>
            <div class="h-0.5 w-20 bg-blue-400 mx-auto mb-6"></div>
            <p class="text-gray-300 text-lg max-w-2xl mx-auto">@_contact.Intro</p>
        </div>

        @* Two-column layout *@
        <div class="grid md:grid-cols-2 gap-12">
            @* Left: Contact info and social links *@
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-white mb-6">Contact Information</h3>

                @* Contact info entries *@
                @foreach (var info in _contact.Info)
                {
                    <div class="flex flex-col">
                        <span class="text-gray-500 text-sm mb-1">@info.Label</span>
                        <a href="@info.Href" class="text-white text-lg hover:text-blue-400 transition-colors">
                            @info.Value
                        </a>
                    </div>
                }

                @* Social links section *@
                <div class="pt-8">
                    <h4 class="text-xl font-semibold text-white mb-4">Social Links</h4>
                    <div class="flex gap-4">
                        @foreach (var link in _contact.SocialLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                               class="px-6 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all duration-200 text-sm font-medium">
                                @link.Name
                            </a>
                        }
                    </div>
                </div>
            </div>

            @* Right: Contact form. Plain HTML POST to FormSubmit, not an EditForm. *@
            <div class="@Styles.GlassFormBg backdrop-blur-2xl border border-white/[0.06] rounded-[32px] p-10 shadow-2xl shadow-black/40">
                <form action="@_contact.FormAction" method="POST" class="space-y-6">

                    @* FormSubmit hidden configuration fields *@
                    <input type="hidden" name="_captcha" value="false" />
                    <input type="hidden" name="_subject" value="New Portfolio Contact Form Submission" />
                    <input type="hidden" name="_template" value="table" />

                    @* Name field *@
                    <div>
                        <label class="block text-white mb-3 font-light text-sm tracking-wide">Name</label>
                        <input type="text" name="name" required class="@Styles.InputField" placeholder="Your name" />
                    </div>

                    @* Email field *@
                    <div>
                        <label class="block text-white mb-3 font-light text-sm tracking-wide">Email</label>
                        <input type="email" name="email" required class="@Styles.InputField"
                               placeholder="your.email@@example.com" />
                    </div>

                    @* Message field (textarea) *@
                    <div>
                        <label class="block text-white mb-3 font-light text-sm tracking-wide">Message</label>
                        <textarea name="message" required class="@Styles.InputField resize-none" rows="5"
                                  placeholder="Your message..."></textarea>
                    </div>

                    @* Submit button *@
                    <button type="submit" class="@Styles.BtnSubmit">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</section>

@* Page footer — a sibling of the contact section, inside the z-10 content wrapper *@
<footer class="w-full py-8 px-8 border-t border-white/10">
    <div class="max-w-7xl mx-auto text-center text-gray-400">
        <p>© @_profile.CopyrightYear @_profile.Name. All rights reserved.</p>
    </div>
</footer>

@code {
    private readonly ContactData _contact = SiteData.Contact;
    private readonly ProfileData _profile = SiteData.Profile;
}
